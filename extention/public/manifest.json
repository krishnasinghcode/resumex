{
  "manifest_version": 3,
  "name": "ResumeX Extension",
  "version": "1.0",
  "description": "Login + Fetch Data",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": ["http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  }
}